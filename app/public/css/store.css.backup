* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    color: #181818;
    background: #faf9f7;
}

a {
    color: inherit;
    text-decoration: none;
}

.container {
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
}

.site-header {
    background: rgba(255,255,255,.95);
    border-bottom: 1px solid #e9e5df;
    position: sticky;
    top: 0;
    z-index: 50;
}

.header-inner {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-weight: 900;
    font-size: 24px;
    letter-spacing: 2px;
}

.main-nav {
    display: flex;
    align-items: center;
    gap: 28px;
}

.main-nav a:hover {
    opacity: .6;
}

.cart-placeholder {
    background: #181818;
    color: white;
    padding: 10px 16px;
    border-radius: 30px;
}

.hero {
    min-height: 520px;
    display: flex;
    align-items: center;
    padding: 80px 0;
    background:
        radial-gradient(
            circle at 80% 30%,
            #e7ded1,
            transparent 35%
        ),
        #f1eee9;
}

.hero h1 {
    font-size: clamp(46px, 7vw, 86px);
    line-height: .98;
    margin: 16px 0 28px;
    max-width: 900px;
    letter-spacing: -4px;
}

.hero p {
    max-width: 560px;
    font-size: 19px;
    color: #666;
    line-height: 1.6;
    margin-bottom: 36px;
}

.eyebrow {
    font-size: 12px;
    letter-spacing: 3px;
    font-weight: 800;
    color: #777;
}

.button {
    display: inline-block;
    border: 0;
    background: #181818;
    color: white;
    border-radius: 10px;
    padding: 15px 24px;
    font-weight: 700;
    cursor: pointer;
}

.button:disabled {
    opacity: .4;
    cursor: not-allowed;
}

.products-section {
    padding: 80px 0;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: end;
    margin-bottom: 30px;
}

.section-heading h2 {
    font-size: 38px;
    margin: 8px 0 0;
}

.search-form {
    display: flex;
    gap: 8px;
}

.search-form input {
    min-width: 260px;
    padding: 12px 14px;
    border: 1px solid #ddd;
    border-radius: 8px;
}

.search-form button {
    border: 0;
    border-radius: 8px;
    padding: 0 18px;
    background: #181818;
    color: #fff;
}

.category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 38px;
}

.category-pill {
    padding: 9px 15px;
    border: 1px solid #ddd;
    background: white;
    border-radius: 30px;
}

.category-pill.active {
    background: #181818;
    border-color: #181818;
    color: white;
}

.product-grid {
    display: grid;
    grid-template-columns:
        repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.product-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #ece8e2;
}

.product-image {
    display: block;
    aspect-ratio: 1 / 1;
    background: #f2f0ec;
    overflow: hidden;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
}

.product-card:hover .product-image img {
    transform: scale(1.025);
}

.image-placeholder,
.main-image-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: #aaa;
    font-weight: 900;
    letter-spacing: 2px;
}

.product-content {
    padding: 20px;
}

.product-category {
    color: #888;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
}

.product-content h3 {
    margin: 8px 0;
    font-size: 20px;
}

.product-description {
    color: #707070;
    line-height: 1.5;
}

.product-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: end;
    margin-top: 20px;
}

.price {
    display: flex;
    flex-direction: column;
}

.price strong {
    font-size: 19px;
}

.old-price {
    color: #999;
    text-decoration: line-through;
    font-size: 13px;
}

.product-link {
    font-weight: 700;
}

.product-page {
    padding: 50px 0 90px;
}

.back-link {
    display: inline-block;
    margin-bottom: 30px;
    color: #777;
}

.product-detail {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 70px;
}

.main-product-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #eee;
    border-radius: 18px;
}

.main-image-placeholder {
    aspect-ratio: 1 / 1;
    background: #efede9;
    border-radius: 18px;
}

.product-info h1 {
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1;
    letter-spacing: -2px;
    margin: 15px 0 20px;
}

.product-lead {
    color: #666;
    font-size: 18px;
    line-height: 1.6;
}

.detail-price {
    margin: 28px 0;
    font-size: 30px;
    font-weight: 800;
}

.variant-section {
    margin-top: 30px;
}

.variant-grid {
    display: grid;
    grid-template-columns:
        repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.variant-card {
    appearance: none;
    border: 2px solid #e4e0da;
    border-radius: 10px;
    background: white;
    padding: 14px;
    text-align: left;
    cursor: pointer;
}

.variant-card:hover {
    border-color: #999;
}

.variant-card.selected {
    border-color: #181818;
    background: #f5f2ed;
}

.variant-material {
    display: block;
    font-weight: 800;
    margin-bottom: 7px;
}

.variant-color {
    display: flex;
    gap: 7px;
    align-items: center;
    color: #666;
}

.color-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid #aaa;
}

.availability {
    margin: 20px 0;
    padding: 14px;
    border-radius: 8px;
    background: #f1eee9;
}

.buy-button {
    width: 100%;
    font-size: 16px;
}

.product-long-description {
    margin-top: 40px;
    line-height: 1.7;
    color: #444;
}

.pagination-simple {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 25px;
}

.empty-state {
    text-align: center;
    padding: 80px 20px;
}

.site-footer {
    padding: 60px 0;
    background: #181818;
    color: white;
    margin-top: 60px;
}

.site-footer p {
    color: #aaa;
}

@media (max-width: 850px) {

    .product-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .product-detail {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .section-heading {
        align-items: stretch;
        flex-direction: column;
    }

    .search-form input {
        min-width: 0;
        flex: 1;
    }

}

@media (max-width: 560px) {

    .container {
        width: min(100% - 24px, 1200px);
    }

    .main-nav {
        gap: 12px;
        font-size: 14px;
    }

    .main-nav a:first-child {
        display: none;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .variant-grid {
        grid-template-columns: 1fr;
    }

}
.add-cart-form {
    margin-top: 20px;
}

.quantity-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.quantity-row input {
    width: 80px;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 8px;
}

.cart-page {
    padding: 60px 0 100px;
}

.cart-page > .container > h1 {
    font-size: 48px;
    margin-bottom: 35px;
}

.success-message {
    background: #e9f5ec;
    padding: 14px 18px;
    border-radius: 10px;
    margin-bottom: 25px;
}

.cart-layout {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 50px;
}

.cart-item {
    display: grid;
    grid-template-columns:
        90px
        minmax(180px, 1fr)
        110px
        130px
        110px
        60px;
    gap: 18px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid #ddd;
}

.cart-item-image {
    width: 90px;
    height: 90px;
    background: #eee;
    border-radius: 10px;
    overflow: hidden;
}

.cart-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.cart-item-info h2 {
    font-size: 17px;
    margin: 0 0 5px;
}

.cart-item-info p {
    margin: 0 0 4px;
    color: #666;
}

.cart-item-info small {
    color: #999;
}

.cart-quantity {
    display: flex;
    gap: 5px;
}

.cart-quantity input {
    width: 55px;
    padding: 8px;
}

.cart-quantity button,
.remove-button {
    border: 0;
    cursor: pointer;
}

.remove-button {
    background: transparent;
    color: #a00;
}

.cart-summary {
    background: white;
    border: 1px solid #e4e0da;
    border-radius: 16px;
    padding: 25px;
    height: max-content;
    position: sticky;
    top: 100px;
}

.cart-summary h2 {
    margin-top: 0;
}

.summary-row,
.summary-total {
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

.summary-row {
    padding: 15px 0;
    border-bottom: 1px solid #eee;
}

.summary-total {
    padding: 22px 0;
    font-size: 20px;
}

.checkout-button {
    width: 100%;
    margin-bottom: 15px;
}

.cart-summary small {
    display: block;
    color: #777;
    text-align: center;
}

@media (max-width: 950px) {

    .cart-layout {
        grid-template-columns: 1fr;
    }

    .cart-summary {
        position: static;
    }

    .cart-item {
        grid-template-columns: 80px 1fr;
    }

    .cart-item-price,
    .cart-quantity,
    .cart-item-total,
    .cart-item form:last-child {
        grid-column: 2;
    }

}
